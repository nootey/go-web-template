# Server config
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DB config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go-web-template

# App config
ENVIRONMENT=local
LOG_LEVEL=debug

# Seed config
ROOT_USER="root@local.host"
ROOT_PASSWORD="password"

# Auth config
JWT_ACCESS_SECRET="secret"
JWT_REFRESH_SECRET="secret"
JWT_ENCODE_ID_SECRET="secret"
TTL_ACCESS=600 # 10 minutes
TTL_REFRESH_SHORT=86400 # 24 hours
TTL_REFRESH_LONG=604800 # 7 days
# Server config
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
CORS_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:5173

# DB config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=go-web-template

# App config
APP_ENVIRONMENT=local
APP_LOG_LEVEL=debug
APP_COOKIE_DOMAIN=

# Web client config
WEB_CLIENT_DOMAIN=localhost
WEB_CLIENT_PORT=5173

# Seed config
SEED_ROOT_USER="root@local.host"
SEED_ROOT_PASSWORD="password"

# Redis config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session config
SESSION_TTL_HOURS=24 # 1 day
SESSION_REMEMBER_ME_TTL_HOURS=336 # 14 days

# Tokens config
TOKEN_CONFIRM_TTL_HOURS=24 # email confirmation link lifetime
TOKEN_RESET_TTL_MINUTES=60 # password reset link lifetime

# Mailer config (leave MAILER_HOST empty to log links to the console instead of sending)
MAILER_HOST=
MAILER_PORT=587
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=no-reply@localhost
MAILER_FROM_NAME="Go Web Template"
                      "datasource": {
                        "name": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum (rate(http_server_request_duration_seconds_count{job=\"api\", http_route=~\"$route\"}[$__rate_interval]))",
                        "legendFormat": "__auto",
                        "range": true,
                        "instant": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
